{
  "name": "faber-ui",
  "version": "0.0.0",
  "private": true,
  "description": "A modular, accessible, and strongly typed design system for React.",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "typescript",
    "styled-components",
    "accessibility"
  ],
  "author": "Eduardo Schork",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardo-schork/faber-ui.git"
  },
  "homepage": "https://github.com/eduardo-schork/faber-ui#readme",
  "bugs": {
    "url": "https://github.com/eduardo-schork/faber-ui/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "website": "turbo run dev --filter=@faber-ui/website",
    "build:website": "turbo run build --filter=@faber-ui/website",
    "storybook": "turbo run dev --filter=@faber-ui/storybook",
    "build:storybook": "turbo run build --filter=@faber-ui/storybook",
    "lint": "bun run lint:tooling && turbo run lint",
    "lint:tooling": "node scripts/check-kebab-case-paths.mjs && eslint eslint.config.js prettier.config.mjs eslint-rules scripts",
    "typecheck": "turbo run typecheck",
    "test": "bun run test:tooling && turbo run test",
    "test:tooling": "vitest run eslint-rules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "bun run build && node scripts/publish-packages.mjs && changeset tag",
    "release:dry-run": "bun run build && node scripts/publish-packages.mjs --dry-run",
    "release:stage": "bun run build && node scripts/publish-packages.mjs --stage && changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "9.39.2",
    "@swc/plugin-styled-components": "^15.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.29.0",
    "nanoid": "^3.3.20",
    "postcss": "^8.5.29",
    "source-map-js": "^1.2.2",
    "undici": "^7.29.0"
  }
}
