{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "eslint-rules/**",
    "eslint.config.js",
    "prettier.config.mjs",
    "tsconfig.base.json",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**", ".next/**", "!.next/cache/**", "out/**"],
      "env": ["FABER_UI_STATIC_EXPORT", "FABER_UI_BASE_PATH", "NEXT_PUBLIC_STORYBOOK_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
