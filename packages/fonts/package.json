{
  "name": "@faber-ui/fonts",
  "version": "0.1.0",
  "description": "Local font assets and font-family foundations for Faber UI.",
  "keywords": [
    "design-system",
    "ui",
    "fonts",
    "typography",
    "variable-font"
  ],
  "author": "Eduardo Schork",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardo-schork/faber-ui.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/eduardo-schork/faber-ui#readme",
  "bugs": {
    "url": "https://github.com/eduardo-schork/faber-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./OFL.txt": "./dist/OFL.txt",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node scripts/build-font-assets.mjs && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0"
  }
}
