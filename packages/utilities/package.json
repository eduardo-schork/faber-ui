{
  "name": "@faber-ui/utilities",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent utilities for Faber UI.",
  "keywords": [
    "design-system",
    "ui",
    "utilities",
    "typescript",
    "css-variables"
  ],
  "author": "Eduardo Schork",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardo-schork/faber-ui.git",
    "directory": "packages/utilities"
  },
  "homepage": "https://github.com/eduardo-schork/faber-ui#readme",
  "bugs": {
    "url": "https://github.com/eduardo-schork/faber-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc -p tsconfig.json"
  }
}
