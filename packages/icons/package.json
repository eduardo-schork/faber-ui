{
  "name": "@faber-ui/icons",
  "version": "0.1.0",
  "description": "Icon components and assets for Faber UI.",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "icons",
    "typescript",
    "accessibility"
  ],
  "author": "Eduardo Schork",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardo-schork/faber-ui.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/eduardo-schork/faber-ui#readme",
  "bugs": {
    "url": "https://github.com/eduardo-schork/faber-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc -p tsconfig.json"
  }
}
